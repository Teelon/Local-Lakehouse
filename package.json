{
  "name": "local-lakehouse-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "dev:worker": "python -m uvicorn app.main:app --app-dir services/worker --host 0.0.0.0 --port 8000 --reload"
  }
}
