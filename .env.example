# ==============================================================================
# Local Lakehouse MVP 1 Environment Configuration
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=info

# PostgreSQL (Shared between Payload CMS and DuckLake Catalog)
POSTGRES_USER=lakehouse_admin
POSTGRES_PASSWORD=lakehouse_secret_change_me
POSTGRES_DB=lakehouse
POSTGRES_PORT=5433
POSTGRES_HOST=postgres
DATABASE_URI=postgres://lakehouse_admin:lakehouse_secret_change_me@postgres:5432/lakehouse

# Object Storage (S3 / MinIO / RustFS compatible)
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ROOT_USER=lakehouse_storage_admin
S3_ROOT_PASSWORD=storage_secret_change_me
S3_BUCKET_NAME=lakehouse-bucket
S3_ENDPOINT=http://storage:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

# Control Plane (Next.js + Payload CMS)
WEB_PORT=3000
PAYLOAD_SECRET=replace_with_a_secure_random_key_for_payload_jwt_and_encryption
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Processing Worker (Python + FastAPI)
WORKER_PORT=8000
WORKER_URL=http://worker:8000
